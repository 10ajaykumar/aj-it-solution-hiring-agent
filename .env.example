# Port and host for the Express server (API + built front end)
PORT=3001
HOST=127.0.0.1

# Owner token (32+ chars). Generate one with:
#   node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
# Open the app once with /#admin=<token> to unlock the "Access list" in the left panel.
# Leave empty to disable owner features.
ADMIN_TOKEN=

# Set only when running behind a reverse proxy, e.g. "loopback" or "1", so rate limits see real client IPs
TRUST_PROXY=

# Where visitors.json and exported reports are stored
DATA_DIR=data
